---
import BaseLayout from '../layouts/BaseLayout.astro';
export function getStaticPaths() {
  return [
    { params: { section: 'articles' }, props: { title: '文章', text: '还没有发布的笔记。' } },
    { params: { section: 'archive' }, props: { title: '笔记归档', text: '还没有可以归档的笔记。' } },
    { params: { section: 'about' }, props: { title: '关于这本手记', text: '这里收着圈圈的技术笔记和生活记录。' } },
  ];
}
const { title, text } = Astro.props;
---
<BaseLayout title={title}><section class="interior"><h1>{title}</h1><p>{text}</p></section></BaseLayout>
