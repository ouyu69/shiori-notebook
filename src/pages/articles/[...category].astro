---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';
export function getStaticPaths() {
  return [
    { params: { category: undefined }, props: { filter: '全部' } },
    { params: { category: 'tech' }, props: { filter: '技术' } },
    { params: { category: 'life' }, props: { filter: '生活' } },
  ];
}
const { filter } = Astro.props;
const posts = (await getPosts()).filter(post => filter === '全部' || post.category === filter);
---
<BaseLayout title="文章"><section class="interior">
  <header class="articles-heading">
    <h1>文章</h1>
    <img class="reading-character" src="/assets/character-reading-blink.gif" width="384" height="576" alt="" aria-hidden="true" decoding="async" />
  </header>
  <nav class="filters" aria-label="文章分类">
    {[['全部','/articles/'],['技术','/articles/tech/'],['生活','/articles/life/']].map(([name, href]) =>
      <a href={href} aria-current={filter === name ? 'page' : undefined}>{name}</a>)}
  </nav>
  <PostList posts={posts} empty={filter === '全部' ? '还没有发布的笔记。' : '这个分类还没有笔记。'} />
</section></BaseLayout>

<style>
  .articles-heading {
    position: relative;
    min-height: 124px;
    display: flex;
    align-items: flex-end;
    border-bottom: 1px solid var(--line);
  }
  .articles-heading h1 { margin: 0; padding: 0 156px 20px 0; }
  .reading-character {
    position: absolute;
    right: 12px;
    bottom: -62px;
    width: 128px;
    height: auto;
    pointer-events: none;
    user-select: none;
  }
  .filters { padding-right: 156px; min-height: 48px; }
  @media (max-width: 580px) {
    .articles-heading { min-height: 96px; }
    .articles-heading h1 { padding-right: 104px; }
    .reading-character { width: 88px; right: 0; bottom: -43px; }
    .filters { padding-right: 96px; gap: 6px; min-height: 36px; }
    .filters a { padding-inline: 10px; }
  }
</style>
